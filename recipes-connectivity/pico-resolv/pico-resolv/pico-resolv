#!/bin/sh
# pico-resolv: write /etc/resolv.conf from systemd-networkd's DNS state.
#
# networkd has no /etc/resolv.conf writer of its own -- it only exports DNS
# to /run/systemd/netif/state and /run/systemd/netif/leases/<ifindex>, both
# explicitly marked "do not parse" upstream. This script never touches
# those files: it reads DNS through `networkctl status`, the supported
# interface, so it stays correct across upstream state-file format changes.
#
# If networkd has nothing to report yet (no lease, or the read fails), the
# existing /etc/resolv.conf is left untouched -- never truncate a working
# file just because this run came up empty.

set -eu

RESOLV_CONF="/etc/resolv.conf"

status="$(networkctl status --no-pager 2>/dev/null)" || exit 0
[ -n "$status" ] || exit 0

# The "DNS:" label line holds the first server; any following lines that
# are bare addresses (no new "Label:") are additional servers. Stop
# collecting as soon as another labelled line (e.g. "NTP:") appears.
dns_servers="$(printf '%s\n' "$status" | awk '
    /^[[:space:]]*DNS:/ {
        insec = 1
        sub(/^[[:space:]]*DNS:[[:space:]]*/, "")
        if (length($0)) print
        next
    }
    insec && /^[[:space:]]*[A-Za-z][A-Za-z ]*:/ { insec = 0 }
    insec && /^[[:space:]]*[0-9A-Fa-f.:]+[[:space:]]*$/ {
        s = $0
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
        print s
        next
    }
')"

domain="$(printf '%s\n' "$status" | awk '
    /^[[:space:]]*Search Domains:/ {
        sub(/^[[:space:]]*Search Domains:[[:space:]]*/, "")
        if (length($0)) print
        exit
    }
')"

# Nothing learned yet -- leave the existing resolv.conf alone.
[ -n "$dns_servers" ] || exit 0

tmp="${RESOLV_CONF}.pico-resolv.$$"
trap 'rm -f "$tmp"' EXIT

{
    printf '# Generated by pico-resolv from systemd-networkd DNS state.\n'
    [ -n "$domain" ] && printf 'search %s\n' "$domain"
    for ip in $dns_servers; do
        printf 'nameserver %s\n' "$ip"
    done
} > "$tmp"

chmod 0644 "$tmp"
mv -f "$tmp" "$RESOLV_CONF"
