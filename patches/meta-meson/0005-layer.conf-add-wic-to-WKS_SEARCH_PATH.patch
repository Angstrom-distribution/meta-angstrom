From 2b3000c735979e38ecdfd52e55b8fa8584f2f5eb Mon Sep 17 00:00:00 2001
From: Koen Kooi <koen@dominion.thruhere.net>
Date: Mon, 3 Aug 2026 00:18:03 +0200
Subject: [PATCH] layer.conf: add wic/ to WKS_SEARCH_PATH

The layer's .wks files (sdimage-meson.wks, sdimage-bootpart-meson.wks)
live under wic/, not the files/wic/ convention that
image_types_wic.bbclass's default WKS_SEARCH_PATH actually searches.
Every other layer in this build follows files/wic/; append this
layer's own directory rather than relocating the files.

layer.conf is parsed before any recipe/class, and BitBake treats a
variable that has had any operator applied -- including :append -- as
"already set". So a plain WKS_SEARCH_PATH:append here would make
image_types_wic.bbclass's own `WKS_SEARCH_PATH ?= ...` default (the
BBPATH-driven files/wic/ search every other layer relies on) silently
no-op, dropping the default search path for every image in this
build, not just meson ones -- e.g. beaglebone's console-base-image
would stop finding meta-ti-bsp/files/wic/sdimage-2part.wks. Seed that
same default explicitly first, so the append only adds to it.

Fixes do_image_wic failing with "No kickstart files from WKS_FILES
were found" on libretech-ac.

Signed-off-by: Koen Kooi <koen@dominion.thruhere.net>
---
 conf/layer.conf | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/conf/layer.conf b/conf/layer.conf
index 1eac962..b1c2d7e 100644
--- a/conf/layer.conf
+++ b/conf/layer.conf
@@ -14,3 +14,11 @@ LAYERSERIES_COMPAT_meson = "walnascar whinlatter wrynose"
 LAYERVERSION_meson = "1"

 LAYERDEPENDS_meson = "core"
+
+# Seed the same default oe-core's image_types_wic.bbclass would otherwise set
+# via "?=" below (each layer's own files/wic/ dir, via BBPATH). :append below
+# makes bitbake treat WKS_SEARCH_PATH as "already set" by the time that
+# class's own weak default runs during recipe parsing, silently defeating it
+# for every image in this build, not just meson ones -- so replicate it here.
+WKS_SEARCH_PATH ?= "${@':'.join('%s/files/wic' % p for p in '${BBPATH}'.split(':'))}"
+# This layer's .wks files live in wic/, not the files/wic/ convention above.
+WKS_SEARCH_PATH:append = ":${LAYERDIR}/wic"
--
